{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Creature Card Schema",
  "type": "object",
  "required": ["Type", "Name", "Description", "Mana", "Cards", "Defence", "Movement", "Health", "Background", "Faction", "Tier"],
  "properties": {
    "Type":       { "const": "Creature" },
    "Name":       { "type": "string" },
    "Faction":    { "type": "string", "enum": ["Demon","Magic","Wild","Undead","All"] },
    "Description":{"type": "string" },
    "Mana":       { "type": "integer" },
    "Food":       { "type": "integer" },
    "Cards":      { "type": "integer" },
    "Defence":    { "type": "integer" },
    "Movement":   { "type": "integer" },
    "Health":     { "type": "integer" },
    "Tier":       { "type": "integer", "enum": [1,2,3,4] },
    "Background": { "type": "string" }
  },
  "additionalProperties": false
}
