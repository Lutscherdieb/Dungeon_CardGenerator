{
  "$defs": {
    "CreatureType": {
      "description": "The game's creature types, plus the wildcard.\n\nA closed set defined by the game itself (Rules/Rules.txt, \"Basic Creature\nType Boons\"), not by anything in this repo -- so it is enumerated here on\npurpose rather than derived from the asset directory, which also holds\nresource and stat icons.",
      "enum": [
        "Demon",
        "Undead",
        "Magic",
        "Wild",
        "All"
      ],
      "title": "CreatureType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "Name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "Mana": {
      "minimum": 0,
      "title": "Mana",
      "type": "integer"
    },
    "Cards": {
      "minimum": 0,
      "title": "Cards",
      "type": "integer"
    },
    "Food": {
      "default": 0,
      "minimum": 0,
      "title": "Food",
      "type": "integer"
    },
    "Description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "Starter": {
      "default": false,
      "title": "Starter",
      "type": "boolean"
    },
    "Defence": {
      "title": "Defence",
      "type": "integer"
    },
    "Movement": {
      "minimum": 0,
      "title": "Movement",
      "type": "integer"
    },
    "Health": {
      "minimum": 0,
      "title": "Health",
      "type": "integer"
    },
    "Type": {
      "const": "Overlord",
      "title": "Type",
      "type": "string"
    },
    "Creatures": {
      "items": {
        "$ref": "#/$defs/CreatureType"
      },
      "title": "Creatures",
      "type": "array"
    }
  },
  "required": [
    "Name",
    "Mana",
    "Cards",
    "Defence",
    "Movement",
    "Health",
    "Type"
  ],
  "title": "Overlord Card",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "GENERATED from src/cardgen/model/cards.py by `python -m cardgen.model.schemas` -- do not hand-edit.",
  "x-key-order": [
    "Type",
    "Name",
    "Starter",
    "Description",
    "Mana",
    "Cards",
    "Food",
    "Defence",
    "Movement",
    "Health",
    "Creatures"
  ]
}
